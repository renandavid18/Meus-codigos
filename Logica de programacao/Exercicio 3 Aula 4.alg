algoritmo "semnome"
// Função :
// Autor :
// Data : 08/03/2026
// Seção de Declarações 
var
  num :inteiro
  x :inteiro
inicio
escreval("Digite um valor qualquer e descubra sua tabuada de 0 à 10")
leia(num)

 para x de 1 ate 10 faca

   escreval(x, " X ", num, " = ", x * num)
 fimpara

fimalgoritmo
