algoritmo "semnome"
// Função :
// Autor :
// Data : 13/03/2026
// Seção de Declarações 
var
   copo, result : real
inicio
   result <- 10
   enquanto result <> 0 faca
   
   escreval("Digite um valor que ele será multiplicado por ele mesmo (obs: digite 0 para finalizar)")
   leia(copo)

   result := copo * copo

   escreval("o resultado é: ", " ", result)
   
   fimenquanto
fimalgoritmo
