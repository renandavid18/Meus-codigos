algoritmo "semnome"
// Função :
// Autor :
// Data : 13/03/2026
// Seção de Declarações 
var
  vValores :vetor [1..5] de inteiro
  x :inteiro
inicio
  vValores[1] <- 130
  vValores[2] <- 2140
  vValores[3] <- 620
  vValores[4] <- 400
  vValores[5] <- 33
  
  para x de 1 ate 5 faca
    escreval(vValores[x])
  fimpara
fimalgoritmo
