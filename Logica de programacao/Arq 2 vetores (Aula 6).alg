algoritmo "semnome"
// Função :
// Autor :
// Data : 13/03/2026
// Seção de Declarações 
var
  vValores :vetor [1..5] de inteiro
  x :inteiro
inicio
  para x de 1 ate 5 faca
   escreval("Digite um valor do vetor na posição ", x)
   leia(Vvalores[x])
  fimpara
  para x de 1 ate 5 faca
    escreval(vValores[x])
  fimpara
fimalgoritmo
