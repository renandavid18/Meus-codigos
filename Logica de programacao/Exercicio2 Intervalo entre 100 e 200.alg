algoritmo "semnome"
// Função :
// Autor :
// Data : 20/12/2025
// Seção de Declarações 
var
num1 : real
inicio
escreval("digite um numero para saber se ele está entre 100 e 200")
leia (num1)
escreval()
 se (num1 >= 100)  e (num1 <= 200) entao
   escreval("O número ",num1," está entre 100 e 200")
 senao
   escreval("O número ",num1," não está entre 100 e 200")
 fimse
fimalgoritmo
